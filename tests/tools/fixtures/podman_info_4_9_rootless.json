{
  "host": {
    "arch": "amd64",
    "cgroupControllers": [
      "cpu",
      "memory",
      "pids"
    ],
    "cgroupManager": "systemd",
    "cgroupVersion": "v2",
    "idMappings": {
      "gidmap": [
        {
          "container_id": 0,
          "host_id": 1000,
          "size": 1
        },
        {
          "container_id": 1,
          "host_id": 100000,
          "size": 65536
        }
      ],
      "uidmap": [
        {
          "container_id": 0,
          "host_id": 1000,
          "size": 1
        },
        {
          "container_id": 1,
          "host_id": 100000,
          "size": 65536
        }
      ]
    },
    "linkmode": "dynamic",
    "networkBackend": "netavark",
    "ociRuntime": {
      "name": "crun",
      "package": "crun-1.31-1"
    },
    "os": "linux",
    "security": {
      "apparmorEnabled": false,
      "rootless": true,
      "seccompEnabled": true,
      "selinuxEnabled": false
    }
  },
  "version": {
    "APIVersion": "4.9.3",
    "Arch": "amd64",
    "GoVersion": "go1.22.1",
    "Os": "linux",
    "Version": "4.9.3"
  }
}
